# ==============================================================================
# 🔐 Variables d'environnement pour scripts/backup_offsite_restic.sh
# À copier sur le NAS dans /etc/homelab-restic.env avec des droits stricts :
#   sudo cp scripts/restic.env.example /etc/homelab-restic.env
#   sudo chmod 600 /etc/homelab-restic.env
# ==============================================================================

# Mot de passe secret pour le chiffrement Restic (À CONSERVER PRÉCIEUSEMENT !)
# Sans ce mot de passe, il est mathématiquement IMPOSSIBLE de déchiffrer vos données.
RESTIC_PASSWORD="change_me_un_mot_de_passe_tres_long_et_securise"

# Identifiants de connexion SFTP o2switch
SFTP_USER="votre_user_cpanel"
SFTP_HOST="votre_serveur.o2switch.net"
SFTP_PORT="22" # Port SSH o2switch (généralement 22 ou le port indiqué dans votre cPanel)

# Chemin du dossier de destination sur votre hébergement o2switch
# Exemple : /home/votre_user_cpanel/backups_homelab
SFTP_PATH="/home/${SFTP_USER}/backups_homelab"

# Chemin vers la clé privée SSH pour la connexion sans mot de passe vers o2switch
# Générée avec : ssh-keygen -t ed25519 -f /root/.ssh/id_o2switch -N ""
SSH_KEY_PATH="/root/.ssh/id_o2switch"

# URL de notification ntfy (port local 2586 sur le NAS)
NTFY_URL="http://localhost:2586/homelab-backups"

# Rétention des snapshots Restic
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
