# ==============================================================================
# Variables d'environnement pour scripts/backup_nas.sh
# À copier sur le NAS dans /etc/homelab-backup.env avec les droits :
#   sudo cp scripts/backup.env.example /etc/homelab-backup.env
#   sudo chmod 600 /etc/homelab-backup.env
# ==============================================================================

# Point de montage de votre disque dur externe USB 2 To
MOUNT_POINT="/media/disque_externe"

# Base de données Nextcloud
NC_DB_CONTAINER="mariadb"
NC_DB_USER="nextcloud_usr"
NC_DB_PASS="change_me_user_password"
NC_DB_NAME="nextcloud_db"

# Base de données PhotoPrism
PP_DB_CONTAINER="photoprism-db"
PP_DB_USER="photoprism"
PP_DB_PASS="change_me_db_password"
PP_DB_NAME="photoprism"

# URL du topic ntfy pour les notifications push (laisser vide pour désactiver)
NTFY_URL="http://localhost:2586/homelab-backups"
