# Clés secrètes aléatoires générées (au moins 32 caractères aléatoires chacune)
# Vous pouvez en générer facilement avec : openssl rand -hex 32
AUTHELIA_JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=change_me_super_secret_storage_key_at_least_32_chars
AUTHELIA_SESSION_SECRET=change_me_super_secret_session_key_at_least_32_chars
