# Clé d'authentification Tailscale réutilisable (à générer sur https://login.tailscale.com/admin/settings/keys)
TS_AUTHKEY=tskey-auth-change_me_votre_cle_tailscale

# Plage d'adresses IP locales de votre réseau domestique (Subnet Router)
# ATTENTION : Ne mettez PAS de guillemets autour de l'IP (écrivez 192.168.1.0/24 et non "192.168.1.0/24")
TS_ROUTES=192.168.1.0/24

# Arguments supplémentaires (Exit Node pour faire passer tout le trafic de votre mobile par le NAS)
TS_EXTRA_ARGS=--advertise-exit-node
