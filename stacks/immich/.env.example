# Emplacement unique où toutes les photos et vidéos sont réunies sur le RAID 5
UPLOAD_LOCATION=/srv/dev-disk-by-uuid-.../immich/library

# Emplacement de la base de données PostgreSQL d'Immich
DB_DATA_LOCATION=/srv/dev-disk-by-uuid-.../immich/postgres

# Fuseau horaire
TZ=Europe/Paris

# Version d'Immich (laisser 'release' pour la dernière version stable)
IMMICH_VERSION=release

# Identifiants PostgreSQL (utiliser uniquement des caractères alphanumériques A-Za-z0-9)
DB_PASSWORD=change_me_postgres_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

